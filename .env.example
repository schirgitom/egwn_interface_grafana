# Copy to .env; fill in independently generated secrets. Never commit .env.
SERVICE_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USER=bootstrap-admin
KEYCLOAK_ADMIN_PASSWORD=
# Directory containing login/theme.properties; must exist on the Docker host.
# KEYCLOAK_THEME_DIR=./keycloak/theme/egwn
GRAFANA_ADMIN_USER=provisioner
GRAFANA_ADMIN_PASSWORD=
GRAFANA_SECRET_KEY=
GRAFANA_OIDC_SECRET=
# Enable only after the Persistence database has meter_points.energy_direction (consumption/generation)
# and both Grafana and this service can reach the same private Docker network.
MEASUREMENT_ENABLED=false
PERSISTENCE_DB_HOST=egwn-timescaledb
PERSISTENCE_DB_PORT=5432
PERSISTENCE_DB_NAME=egwndata2
PERSISTENCE_API_URL=https://egwnpersistence-worker:8443
PERSISTENCE_SERVICE_TOKEN=
PROVISIONER_OIDC_SECRET=
INTERNAL_TOKEN=
REGISTRATION_HASH_KEY=
GRAFANA_DOMAIN=grafana.example.com
KEYCLOAK_DOMAIN=login.example.com
REGISTRATION_DOMAIN=registration.example.com
RABBITMQ_HOST=rabbitmq.example.com
RABBITMQ_PORT=5671
RABBITMQ_VHOST=/
RABBITMQ_USER=
RABBITMQ_PASSWORD=

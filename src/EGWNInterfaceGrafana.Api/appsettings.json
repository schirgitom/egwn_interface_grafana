{
  "RabbitMQ": {
    "Enabled": false,
    "Exchange": "egwncentral.events",
    "RoutingKey": "customer.created.v1",
    "Queue": "grafana.customer-created.v1"
  },
  "Consul": {
    "Enabled": false,
    "Address": "http://localhost:8500",
    "Key": "egwninterfacegrafana/appsettings"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
